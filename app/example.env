# How far back scrapers look for new content (default 168 = 7 days)
SCRAPE_HOURS=168

# true = no OpenAI calls for digests/email ranking (feed excerpts only)
USE_FALLBACK_DIGESTS=false

OPENAI_API_KEY=

MY_EMAIL=
APP_PASSWORD=

# Supabase API (optional; for a future Next.js frontend — not used by SQLAlchemy)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase Postgres: Project Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres:PASSWORD@db.REF.supabase.co:5432/postgres?sslmode=require

POSTGRES_HOST=db.YOUR_PROJECT_REF.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
POSTGRES_DB=postgres
POSTGRES_SSLMODE=require

